<Window x:Class="CompteurCarnet.SelectCarnetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélectionner un carnet" Height="420" Width="420"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sélectionner un carnet"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,15"/>

        <ListBox x:Name="ListeCarnets" Grid.Row="1"
                 Background="{StaticResource CardBrush}"
                 Foreground="White"
                 BorderThickness="0"
                 FontSize="14"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnAnnuler" Content="Annuler" Style="{StaticResource SmallButton}"
                    Background="{StaticResource RedBrush}" Margin="0,0,10,0" Click="BtnAnnuler_Click"/>
            <Button x:Name="BtnOk" Content="Choisir" Style="{StaticResource SmallButton}"
                    Background="{StaticResource BlueBrush}" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
